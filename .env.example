# =============================================================================
# Environment — Hermes MEP Drawing Review Platform
# Copy to .env and fill in your keys.
# =============================================================================

# --- LLM Provider Keys (at least one required) ---
# OpenRouter: access many models with one key
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI: GPT-4, Codex CLI, etc.
OPENAI_API_KEY=sk-...

# Anthropic: Claude models
ANTHROPIC_API_KEY=sk-ant-...

# --- Hermes Configuration ---
# Active profile (default, ollama, etc.)
HERMES_PROFILE=default

# --- Optional: Local inference (Ollama / vLLM / llama.cpp) ---
# Set base URL if running a local LLM server alongside Docker
# OLLAMA_BASE_URL=http://host.docker.internal:11434
