# =============================================================================
# Environment — Hermes MEP Drawing Review Platform
# Copy to .env and fill in your keys.
# =============================================================================

# --- Cloud LLM Provider Keys (optional if using Ollama) ---
# OpenRouter: access many models with one key
OPENROUTER_API_KEY=*** OpenAI: GPT-4, Codex CLI, etc.
OPENAI_API_KEY=*** Anthropic: Claude models
ANTHROPIC_API_KEY=*** --- Ollama (local / self-hosted inference) ---
# Base URL reachable from the Hermes container.
#   "http://ollama:11434"  → inside Docker network (default)
#   "http://host.docker.internal:11434" → Ollama running on host (macOS/Win)
#   "http://192.168.1.100:11434" → Ollama on another machine
OLLAMA_BASE_URL=http://ollama:11434

# Default model tag to use for MEP review tasks
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Hermes Configuration ---
HERMES_PROFILE=default

# --- GPU (uncomment in docker-compose.yml if NVIDIA available) ---
# For CPU-only Ollama, set inside docker-compose.yml or here:
# OLLAMA_CPU_ONLY=1
